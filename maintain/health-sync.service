[Unit]
Description=health-sync: Google Health <-> Intervals.icu sync
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root
ExecStart=/usr/bin/docker compose -f /root/docker-compose.yaml run --rm --pull always health-sync
TimeoutStartSec=15min
